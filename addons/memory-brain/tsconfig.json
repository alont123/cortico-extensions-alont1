{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true, "noEmit": true, "strict": true,
    "esModuleInterop": true, "skipLibCheck": true, "types": ["node"],
    "lib": ["ES2023", "DOM"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
